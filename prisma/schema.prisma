// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @unique @default(cuid())
  email         String        @unique
  password      String?
  name          String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  subscription  Subscription?
  Form          Form[]
  role          Role          @default(PHOTOGRAPHER)

  sessions Session[]
  accounts Account[]
  passkeys Passkey[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?

  @@map("passkey")
}

model Form {
  id          String   @id @unique @default(cuid())
  uuid        String   @unique @default(uuid())
  name        String
  slug        String
  fields      Json[]
  responses   Json[]
  isPublished Boolean  @default(false)
  isAnswered  Boolean  @default(false)
  shareUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  formFields FormField[]

  User   User   @relation(fields: [userId], references: [id])
  userId String

  @@map("form")
}

model FormField {
  id        Int     @id @default(autoincrement())
  label     String
  fieldType String
  required  Boolean @default(false)
  form      Form    @relation(fields: [formId], references: [id])
  formId    String

  @@map("form_field")
}

model Subscription {
  id             String             @id @unique @default(cuid())
  user           User               @relation(fields: [userId], references: [id])
  userId         String             @unique
  status         SubscriptionStatus @default(FREE)
  polarProductId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription")
}

enum Role {
  USER
  PHOTOGRAPHER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  FREE
  CANCELLED
  PENDING
}
