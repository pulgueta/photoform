{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "extends": ["ultracite"],
  "overrides": [
    {
      "include": ["*.astro"],
        "linter": {
          "rules": {
            "style": {
              "useConst": "off",
              "useImportType": "off"
            }
          }
        },
      "javascript": {
        "formatter": {
          "quoteStyle": "double"
        }
      }
    }
    
  ]
}
